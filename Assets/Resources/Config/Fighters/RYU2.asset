      _state: jump
    - _token: left
      _state: back
    - _token: right
      _state: forward
    - _token: down
      _state: crouch
    - _token: upright
      _state: jump_forward
    - _token: rightup
      _state: jump_forward
    - _token: upleft
      _state: jump_back
    - _token: leftup
      _state: jump_back
